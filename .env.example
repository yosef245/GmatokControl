# Supabase project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp Business (Cloud) API — optional; without it the WhatsApp buttons open a prefilled wa.me message.
# Server-only: never prefix these with NEXT_PUBLIC_. Setup steps: Settings → WhatsApp in the app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
